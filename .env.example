# Copy to .env (or set in your hosting) — never commit real values.
DATABASE_URL=jdbc:postgresql://localhost:5432/bakban9
DATABASE_USER=bakban9
DATABASE_PASSWORD=bakban9
BASE_URL=http://localhost:8080

# First owner account: created on startup only while the admins table is empty.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# Local http development only; keep true in production (HTTPS).
SESSION_COOKIE_SECURE=true
# Behind a reverse proxy / load balancer set to native so rate limits see the visitor IP.
FORWARD_HEADERS_STRATEGY=none

# Storage: local (./data/uploads) or s3 (S3, Cloudflare R2, MinIO)
STORAGE_TYPE=local
STORAGE_PUBLIC_BASE_URL=/media
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# SMTP for contact notifications, replies and admin invites (empty = mail is only logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_NOTIFY_TO=
